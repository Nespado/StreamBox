          "showLegend": true
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Collecte — erreur API GCP",
      "description": "0 = dernier appel réussi ; 1 = erreur. Consulter les logs de l’exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
