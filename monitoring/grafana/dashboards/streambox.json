            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Load Balancer — erreurs 5xx",
      "description": "Toutes les routes de l’URL map, y compris les erreurs avant Cloud Run.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "sum(rate(stackdriver_https_lb_rule_loadbalancing_googleapis_com_https_request_count{project_id=\"$project\",url_map_name=\"$url_map\",response_code_class=\"500\"}[$__rate_interval]))",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
