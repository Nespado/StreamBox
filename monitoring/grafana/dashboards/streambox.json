          "showLegend": true
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Collecte — exporter joignable",
      "description": "1 = scrape réussi. Cela ne suffit pas à confirmer que l’API GCP a répondu.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "up{job=\"streambox-gcp\"}",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
