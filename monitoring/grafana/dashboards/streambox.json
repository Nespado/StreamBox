{
  "id": null,
  "uid": "streambox-observability",
  "title": "StreamBox — Observabilité",
  "tags": [
    "streambox",
    "gcp"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Métriques GCP relues par l’exporter. Plusieurs minutes de délai et quelques scrapes sont nécessaires. Utiliser Cloud Monitoring pour les mesures de référence et les alertes.",
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Projet",
        "type": "textbox",
        "current": {
          "text": "streambox-insset-m1-2026",
          "value": "streambox-insset-m1-2026"
        },
        "options": [
          {
            "text": "streambox-insset-m1-2026",
            "value": "streambox-insset-m1-2026",
            "selected": true
          }
        ],
        "query": "streambox-insset-m1-2026",
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "region",
        "label": "Région",
        "type": "textbox",
        "current": {
          "text": "europe-west9",
          "value": "europe-west9"
        },
        "options": [
          {
            "text": "europe-west9",
            "value": "europe-west9",
            "selected": true
          }
        ],
        "query": "europe-west9",
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "service",
        "label": "Cloud Run",
        "type": "textbox",
        "current": {
          "text": "streambox-catalogue",
          "value": "streambox-catalogue"
        },
        "options": [
          {
            "text": "streambox-catalogue",
            "value": "streambox-catalogue",
            "selected": true
          }
        ],
        "query": "streambox-catalogue",
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "url_map",
        "label": "URL map",
        "type": "textbox",
        "current": {
          "text": "streambox-url-map",
          "value": "streambox-url-map"
        },
        "options": [
          {
            "text": "streambox-url-map",
            "value": "streambox-url-map",
            "selected": true
          }
        ],
        "query": "streambox-url-map",
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Catalogue — requêtes/s",
      "description": "Toutes les requêtes du service, toutes révisions confondues.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "sum(rate(stackdriver_cloud_run_revision_run_googleapis_com_request_count{project_id=\"$project\",service_name=\"$service\",location=\"$region\"}[$__rate_interval]))",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Catalogue — latence p95",
      "description": "Latence de traitement dans Cloud Run ; estimation par histogramme, hors démarrage et trajet navigateur.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stackdriver_cloud_run_revision_run_googleapis_com_request_latencies_bucket{project_id=\"$project\",service_name=\"$service\",location=\"$region\"}[$__rate_interval])))",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Catalogue — proportion de 5xx",
      "description": "Absence de série 5xx : le panneau peut être vide. Ne pas interpréter une absence de données comme une preuve de bon fonctionnement.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "sum(rate(stackdriver_cloud_run_revision_run_googleapis_com_request_count{project_id=\"$project\",service_name=\"$service\",location=\"$region\",response_code_class=\"5xx\"}[$__rate_interval])) / sum(rate(stackdriver_cloud_run_revision_run_googleapis_com_request_count{project_id=\"$project\",service_name=\"$service\",location=\"$region\"}[$__rate_interval]))",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cloud Run — instances",
      "description": "Instances actives et inactives, toutes révisions confondues.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "sum(stackdriver_cloud_run_revision_run_googleapis_com_container_instance_count{project_id=\"$project\",service_name=\"$service\",location=\"$region\"})",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Médias — requêtes par résultat du cache",
      "description": "Trafic des backend buckets de cette URL map.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "sum by (cache_result) (rate(stackdriver_https_lb_rule_loadbalancing_googleapis_com_https_request_count{project_id=\"$project\",url_map_name=\"$url_map\",backend_target_type=\"BACKEND_BUCKET\"}[$__rate_interval]))",
          "legendFormat": "{{cache_result}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Médias — proportion de HIT complets",
      "description": "HIT / toutes les requêtes média ; à recouper avec les logs pour les réponses partielles.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "sum(rate(stackdriver_https_lb_rule_loadbalancing_googleapis_com_https_request_count{project_id=\"$project\",url_map_name=\"$url_map\",backend_target_type=\"BACKEND_BUCKET\",cache_result=\"HIT\"}[$__rate_interval])) / sum(rate(stackdriver_https_lb_rule_loadbalancing_googleapis_com_https_request_count{project_id=\"$project\",url_map_name=\"$url_map\",backend_target_type=\"BACKEND_BUCKET\"}[$__rate_interval]))",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Médias — débit distribué",
      "description": "Débit réseau en octets/s, pas un volume cumulé facturable.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "sum(rate(stackdriver_https_lb_rule_loadbalancing_googleapis_com_https_response_bytes_count{project_id=\"$project\",url_map_name=\"$url_map\",backend_target_type=\"BACKEND_BUCKET\"}[$__rate_interval]))",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Médias — débit depuis l’origine",
      "description": "MISS et DISABLED uniquement : les métriques backend incluent aussi des HIT synthétiques. UNKNOWN exclu.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "sum(rate(stackdriver_https_lb_rule_loadbalancing_googleapis_com_https_backend_response_bytes_count{project_id=\"$project\",url_map_name=\"$url_map\",backend_target_type=\"BACKEND_BUCKET\",cache_result=~\"MISS|DISABLED\"}[$__rate_interval]))",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Médias — requêtes à l’origine",
      "description": "MISS et DISABLED uniquement. Une requête client peut provoquer plusieurs accès à l’origine.",
      "datasource": {
        "type": "prometheus",
        "uid": "streambox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streambox-prometheus"
          },
          "expr": "sum(rate(stackdriver_https_lb_rule_loadbalancing_googleapis_com_https_backend_request_count{project_id=\"$project\",url_map_name=\"$url_map\",backend_target_type=\"BACKEND_BUCKET\",cache_result=~\"MISS|DISABLED\"}[$__rate_interval]))",
          "legendFormat": "Valeur",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
